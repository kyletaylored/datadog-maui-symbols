<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Define task assemblies -->
  <UsingTask TaskName="Datadog.MAUI.Symbols.Tasks.UploadSymbolsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)\..\lib\netstandard2.0\Datadog.MAUI.Symbols.dll" />

  <UsingTask TaskName="Datadog.MAUI.Symbols.Tasks.GenerateBuildIdTask"
             AssemblyFile="$(MSBuildThisFileDirectory)\..\lib\netstandard2.0\Datadog.MAUI.Symbols.dll" />

  <!-- Generate DatadogBuildInfo class for runtime access -->
  <Target Name="DatadogGenerateBuildInfo" BeforeTargets="CoreCompile">
    <!-- Generate build ID for all platforms -->
    <GenerateBuildIdTask
      Version="$(DatadogVersion)"
      Variant="$(DatadogVariant)"
      VersionCode="$(ApplicationVersion)">
      <Output TaskParameter="BuildId" PropertyName="_DatadogGeneratedBuildId" />
    </GenerateBuildIdTask>

    <!-- Create DatadogBuildInfo.g.cs with build metadata -->
    <PropertyGroup>
      <_DatadogBuildInfoPath>$(IntermediateOutputPath)Datadog.MAUI.Symbols\DatadogBuildInfo.g.cs</_DatadogBuildInfoPath>
    </PropertyGroup>

    <!-- Write the generated file -->
    <MakeDir Directories="$(IntermediateOutputPath)Datadog.MAUI.Symbols" />

    <PropertyGroup>
      <_DatadogBuildInfoContent>// &lt;auto-generated /&gt;
// This file is automatically generated by Datadog.MAUI.Symbols
// Do not edit this file manually

namespace Datadog.MAUI.Symbols
{
    /// &lt;summary&gt;
    /// Build information for Datadog crash symbolication.
    /// These values are automatically generated and should be passed to the Datadog RUM SDK.
    /// &lt;/summary&gt;
    public static class DatadogBuildInfo
    {
        /// &lt;summary&gt;Service name from DatadogServiceName property&lt;/summary&gt;
        public const string ServiceName = &quot;$(DatadogServiceName)&quot;%3B

        /// &lt;summary&gt;App version from DatadogVersion property&lt;/summary&gt;
        public const string Version = &quot;$(DatadogVersion)&quot;%3B

        /// &lt;summary&gt;Build variant from DatadogVariant property (e.g., Release, Debug)&lt;/summary&gt;
        public const string Variant = &quot;$(DatadogVariant)&quot;%3B

        /// &lt;summary&gt;Build ID for linking crashes to symbol files&lt;/summary&gt;
        public const string BuildId = &quot;$(_DatadogGeneratedBuildId)&quot;%3B
    }
}
</_DatadogBuildInfoContent>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(_DatadogBuildInfoPath)"
      Lines="$(_DatadogBuildInfoContent)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Encoding="UTF-8" />

    <!-- Include in compilation -->
    <ItemGroup>
      <Compile Include="$(_DatadogBuildInfoPath)" />
      <FileWrites Include="$(_DatadogBuildInfoPath)" />
    </ItemGroup>
  </Target>

  <!-- Automatic symbol upload after publish (like the old plugin) -->
  <Target Name="DatadogUploadSymbols" AfterTargets="Publish">
    <Message Importance="high" Text="[Datadog] Symbol upload target triggered for $(TargetPlatformIdentifier)" />

    <!-- Only run for Release builds by default -->
    <PropertyGroup>
      <_DatadogShouldRun Condition="'$(DatadogSymbolUploadEnabled)' == 'false'">false</_DatadogShouldRun>
      <_DatadogShouldRun Condition="'$(_DatadogShouldRun)' == ''">true</_DatadogShouldRun>
      <_DatadogShouldRun Condition="'$(Configuration)' != 'Release'">false</_DatadogShouldRun>
    </PropertyGroup>

    <!-- Early exit when disabled -->
    <Message Condition="'$(_DatadogShouldRun)' != 'true'"
             Importance="high"
             Text="[Datadog] Symbol upload disabled (not Release build or DatadogSymbolUploadEnabled=false)" />

    <!-- Message when API key is not set -->
    <Message Condition="'$(_DatadogShouldRun)' == 'true' AND '$(DatadogApiKey)' == ''"
             Importance="high"
             Text="[Datadog] Symbol upload skipped (DATADOG_API_KEY not set)" />

    <!-- Generate build ID for Android if not provided -->
    <GenerateBuildIdTask
      Condition="'$(TargetPlatformIdentifier)' == 'android' AND '$(_DatadogShouldRun)' == 'true' AND '$(DatadogBuildId)' == ''"
      ApkPath="$(OutputPath)$(AssemblyName)-Signed.apk"
      Version="$(DatadogVersion)"
      Variant="$(DatadogVariant)"
      VersionCode="$(AndroidVersionCode)">
      <Output TaskParameter="BuildId" PropertyName="DatadogBuildId" />
    </GenerateBuildIdTask>

    <!-- Upload symbols - single task handles all platforms -->
    <UploadSymbolsTask
      Condition="'$(_DatadogShouldRun)' == 'true' AND '$(DatadogApiKey)' != ''"
      ApiKey="$(DatadogApiKey)"
      ServiceName="$(DatadogServiceName)"
      Version="$(DatadogVersion)"
      Variant="$(DatadogVariant)"
      BuildId="$(DatadogBuildId)"
      TargetPlatformIdentifier="$(TargetPlatformIdentifier)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      SymbolFilePath="$(DatadogSymbolFilePath)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      Site="$(DatadogSite)"
      DisableGit="$(DatadogDisableGit)"
      RepositoryUrl="$(DatadogRepositoryUrl)"
      IncludeGitMetadata="$(DatadogIncludeGitMetadata)"
      Skip="$(DatadogSymbolUploadSkip)"
      DryRun="$(DatadogSymbolUploadDryRun)"
      SkipApiKeyValidation="$(DatadogSkipApiKeyValidation)"
      Verbose="$(DatadogVerbose)"
      ContinueOnError="true" />
  </Target>

</Project>
