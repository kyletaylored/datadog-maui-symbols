<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>Datadog.MAUI.SymbolsUpload</PackageId>
    <Version>0.1.0</Version>
    <Authors>Datadog</Authors>
    <Description>Native .NET MSBuild plugin for uploading symbol files to Datadog from MAUI applications</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kyletaylored/datadog-maui-symbols-upload</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kyletaylored/datadog-maui-symbols-upload</RepositoryUrl>
    <PackageTags>datadog;symbols;sourcemaps;maui;android;ios;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Include build files in NuGet package -->
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Include .targets and .props files in NuGet package -->
  <ItemGroup>
    <None Include="build\*.props" Pack="true" PackagePath="build\" />
    <None Include="build\Datadog.MAUI.SymbolsUpload.targets" Pack="true" PackagePath="build\" />
    <None Include="build\Datadog.MAUI.SymbolsUpload.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Include README and LICENSE in the package -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
